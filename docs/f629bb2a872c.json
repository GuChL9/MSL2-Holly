          },
          {
            "type": "text",
            "content": "Random sampling results in distributions with large amounts of variability.",
            "correct": false,
            "option_id": "9eacc23d-6b4f-4e0b-996a-e7185e9c33ff"
          },
          {
            "type": "text",
            "content": "Greater variability is found in smaller samples.",
