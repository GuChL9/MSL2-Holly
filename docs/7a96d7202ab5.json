    "questions": [
      {
        "question": [
          {
            "type": "text",
            "content": "A researcher wants to test whether mean systolic blood pressure (SBP) differs among three groups of adults following different diets using one-way ANOVA:"
          },
          {
            "type": "table",
            "headers": [
              "Group",
              "n",
              "SBP (mmHg)"
            ],
            "rows": [
              [
                "A (Low-salt)",
                "5",
                "118, 122, 119, 121, 120"
              ],
              [
                "B (Regular)",
                "5",
                "130, 128, 132, 129, 131"
              ],
              [
                "C (High-fat)",
                "5",
                "135, 138, 134, 136, 137"
              ]
            ],
            "align": [
              "left",
              "right",
              "left"
            ]
          },
          {
            "type": "text",
            "content": "Please perform the test and draw a conclusion (alpha = 0.05, keep two decimals during your calculation)."
          }
        ],
        "answer": [
          {
            "type": "text",
            "content": "$H_0:\\mu_A=\\mu_B=\\mu_C$. 组均值为 120.00,130.00,136.00, 总均值 128.6667. $SS_B=653.3333$, $SS_W=30$, 自由度分别为 2,12, $MS_B=326.6667$, $MS_W=2.5$, $F=130.6667\\approx130.67$. 临界值 $F_{0.95}(2,12)=3.8853$, 拒绝 $H_0$, 至少一组总体均值不同"
          }
        ],
        "explanation": [
          {
            "type": "text",
            "content": "采用单因素 ANOVA, 假设各个体独立, 组内残差近似正态且方差相等. 总体检验显著不代表任意两组均显著, 两两比较需另做相应检验"
          }
        ],
        "sources": [
          {
            "title": "Yangshu - 2025-2026秋小测卷 5",
            "locator": "flashcards 第 1 题",
            "url": "https://github.com/YangShu233-Snow/ZJUBMS-Ginkgo/blob/77e8b155507493b043eb3dadb3f17a22dc1020fe/%E5%8C%BB%E5%AD%A6%E7%A7%91%E5%AD%A6%E7%B4%A0%E5%85%BB%20II/2025-2026%E7%A7%8B%E5%B0%8F%E6%B5%8B%E5%8D%B7%205.json"
          },
          {
            "title": "BMS Database 本地资料 - 2025-2026 学年秋学期（23级）医学科学素养Ⅱ练习与小测 / 小测 5",
            "locator": "第 1 题",
            "url": "https://bms-zju.github.io/BMS_Database/courses/medical-science-literacy-2/quizzes/2025-2026-quizzes/",
            "note": "同源原卷, 与Yangshu题目合并; 2026-11-07本地快照"
          }
